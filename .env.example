# --- Реквизиты по умолчанию (обязательно смените!) ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-please

# Секрет для подписи. Сгенерируйте: openssl rand -hex 32
SECRET_KEY=change-me-to-a-long-random-string

# --- Хранилище ---
# Внутри контейнера путь фиксирован. Наружу монтируется через volume.
STORAGE_ROOT=/data
DATA_DIR=/app-data

# --- Лимиты ---
# Максимальный размер одного файла, МБ
MAX_UPLOAD_MB=2048
# Квота на всё хранилище, ГБ (0 — без ограничения)
DEFAULT_QUOTA_GB=0

# --- Безопасность ---
# Разрешить самостоятельную регистрацию пользователей
ALLOW_REGISTRATION=false
# Время жизни сессии, часы
SESSION_TTL_HOURS=168
# Доверять заголовкам X-Forwarded-* (включайте только за своим прокси)
TRUST_PROXY=true

# --- Порты на хосте ---
# Порт, на котором приложение будет доступно снаружи
APP_PORT=8080
